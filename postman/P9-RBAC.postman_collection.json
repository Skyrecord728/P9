{
  "info": {
    "_postman_id": "a17b1c0f-2f6a-4e50-bf3f-6ff0d9d2a001",
    "name": "P9 RBAC - 登录 菜单树 ADMIN 验证",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 用户登录（USER）",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('登录成功', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.environment.set('userToken', jsonData.tokenType + ' ' + jsonData.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. 获取当前用户菜单树",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('菜单树接口返回成功', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{userToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/menus/my-tree",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "menus",
            "my-tree"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. USER 访问 ADMIN 接口（期望 403）",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('普通用户访问 ADMIN 接口被拒绝', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{userToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/ping",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "ping"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. 管理员登录（ADMIN）",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('管理员登录成功', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.environment.set('adminToken', jsonData.tokenType + ' ' + jsonData.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. ADMIN 访问 ADMIN 接口（期望 200）",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('管理员访问 ADMIN 接口成功', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('返回消息正确', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql('admin endpoint ok');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/ping",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "ping"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userUsername",
      "value": "user"
    },
    {
      "key": "userPassword",
      "value": "user123"
    },
    {
      "key": "adminUsername",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "admin123"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ]
}
